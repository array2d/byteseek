# byteseek 主脑。main 播种提示词后进入 mainbrain 循环：
#   input 等待用户输入 → llm·call 生成一段 kv 程序（layout 到 /lib/byteseek/session/<名>）
#   → byteseek·run 执行它。输入 exit 退出。
# main 无 scope（只是两个调用），可被直接 bootstrap；mainbrain 的 while/if 在嵌套帧里寻址。

lib byteseek {
	rwfunc main() -> () {
		byteseek·seedllm()
		byteseek·seed_prompts()
		byteseek·mainbrain()
	}

	rwfunc seedllm() -> () {
		env·get("DEEPSEEK_API_URL") -> api
		if (api == "") { "https://api.deepseek.com/chat/completions" -> api }
		env·get("DEEPSEEK_API_KEY") -> key
		env·get("BYTESEEK_LLM_PRINT") -> print
		if (print == "") { "1" -> print }
		kv·set("/byteseek/llm.api", api)
		kv·set("/byteseek/llm.key", key)
		kv·set("/byteseek/llm.print", print)
	}

	rwfunc mainbrain() -> () {
		running = 1                            # = 等价于 <-
		while (running == 1) {
			input("byteseek> ") -> userinput
			string·cmp(userinput, "exit") -> q
			if (q == 0) {
				running <- 0
			} else {
				llm·call(userinput) -> entry
				byteseek·run(entry)
			}
		}
		println("bye.")
	}
}
